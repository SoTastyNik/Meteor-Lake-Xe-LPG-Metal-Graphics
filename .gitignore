# GitHub rejects any single file over 100 MB. These are the only files in the
# tree that large, and all of them are reproducible rather than unique:
#   - the four libLLVM.dylib copies are build products of the packaged bundles
#   - the toolchain libLLVM.dylib belongs to the Rust toolchain in toolchain/
#   - the tarball is pinned by SHA256SUMS-upstream.txt
upstream-runtime/pkgroot/Library/GPUBundles/NVMTLDriver.bundle/Contents/MacOS/air-runtime/libLLVM.dylib
latitude-desktop/Library/GPUBundles/NVMTLDriver.bundle/Contents/MacOS/air-runtime/libLLVM.dylib
latitude-runtime/Library/GPUBundles/NVMTLDriver.bundle/Contents/MacOS/air-runtime/libLLVM.dylib
backups/desktop-0.2.6-before/package/Library/GPUBundles/NVMTLDriver.bundle/Contents/MacOS/air-runtime/libLLVM.dylib
toolchain/rustup/toolchains/stable-aarch64-apple-darwin/lib/libLLVM.dylib
# Any libLLVM.dylib is a build product; backups of the full runtime also carry it.
libLLVM.dylib
nullmoth-nvidia-2.0.2.tar.gz

# Regenerable installed runtime and distribution snapshots. These contain build
# products (including >100 MB libLLVM.dylib copies) and are reproduced by the
# build/install step, not tracked in the repo.
checkpoints/
latitude-desktop/WindowServerPlugin/
latitude-desktop/Library/

# Very large third-party reference payloads: Apple's Kernel Debugging Kit
# package and a Fedora live image used for the guided Linux hardware capture.
# Both are re-downloadable and are not project source.
research/kdk-24H32-expanded/
linux-live-media/

# macOS cruft
.DS_Store

# Apple Kernel Debugging Kit disk image (883 MB) — re-downloadable from Apple.
research/Kernel_Debug_Kit_24H32.dmg
