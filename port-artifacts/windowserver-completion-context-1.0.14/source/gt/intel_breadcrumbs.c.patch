@@ -16,6 +16,40 @@
 #include "intel_gt_pm.h"
 #include "intel_gt_requests.h"
 
+/* Completion work can outlive timeline retirement. A request reference alone
+ * does not keep rq->context alive after intel_context_unpin(). The GuC
+ * retirement callback still locks that context (or its parallel parent).
+ * Pair these references with every breadcrumb-owned request reference.
+ */
+static void breadcrumb_request_get(struct i915_request *rq)
+{
+#ifdef NMXKPI
+	struct intel_context *ce = rq->context;
+
+	intel_context_get(ce);
+	if (ce->parallel.parent)
+		intel_context_get(ce->parallel.parent);
+#endif
+	i915_request_get(rq);
+}
+
+static void breadcrumb_request_put(struct i915_request *rq)
+{
+#ifdef NMXKPI
+	struct intel_context *ce = rq->context;
+	struct intel_context *parent = ce->parallel.parent;
+#endif
+	i915_request_put(rq);
+#ifdef NMXKPI
+	/* Save both pointers before the request may be freed/recycled. The
+	 * parent can release its creation reference to the child on destroy.
+	 */
+	if (parent)
+		intel_context_put(parent);
+	intel_context_put(ce);
+#endif
+}
+
