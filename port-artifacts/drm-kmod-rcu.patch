diff --git a/drivers/gpu/drm/drm_file.c b/drivers/gpu/drm/drm_file.c
index 6d25949758..3410296692 100644
--- a/drivers/gpu/drm/drm_file.c
+++ b/drivers/gpu/drm/drm_file.c
@@ -498,7 +498,14 @@ void drm_file_update_pid(struct drm_file *filp)
 #endif
 	mutex_unlock(&dev->filelist_mutex);
 
+	/*
+	 * FreeBSD: the pid is a plain integer (and task_pid() is the thread id,
